# Concatenates the CCD files listed in LIST_FILE into one C++ byte array written to OUT.
file(READ ${LIST_FILE} IN)
set(hex "")
foreach(f ${IN})
  file(READ ${f} h HEX)
  string(APPEND hex "${h}0a")
endforeach()
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
file(WRITE ${OUT}
"// Generated by cmake/embed_ccd.cmake. Do not edit.
#include <cstddef>
namespace od::embedded {
extern const unsigned char kCcdData[] = {
${bytes}0x00};
extern const std::size_t kCcdSize = sizeof(kCcdData) - 1;
}
")
